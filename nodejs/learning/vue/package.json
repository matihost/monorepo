{
  "name": "vue",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "scripts": {
    "serve": "vite --port 3000",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.13.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@highlightjs/vue-plugin": "^2.1.0",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "morgan": "^1.12.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.18",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": false,
    "semi": true,
    "bracketSameLine": true,
    "bracketSpacing": true,
    "vueIndentScriptAndStyle": true,
    "trailingComma": "all",
    "singleAttributePerLine": true,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 120
  },
  "browserslist": {
    "production": [
      "> 0.5%",
      "last 2 versions",
      "not dead"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
